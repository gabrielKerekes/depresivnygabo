---
layout: base.njk
title: Tréningy
permalink: /treningy/
description: Súkromný denník tréningov.
eleventyExcludeFromCollections: true
---
{% from "bodymap.njk" import bodyMap, bodyMapLegend %}
<section class="workouts">
  <h2 class="page-title">Tréningy</h2>
  <p class="start-here-lead">
    Súkromný denník — čo som odcvičil a kedy. Skrytá stránka, dostupná len cez
    priamy odkaz.
  </p>

  {%- if athlete.stats.length %}
  <ul class="athlete-stats">
    {%- for stat in athlete.stats %}
    <li class="athlete-stat">
      <span class="athlete-stat-value">{{ stat.value }}</span>
      <span class="athlete-stat-label">{{ stat.label }}</span>
    </li>
    {%- endfor %}
  </ul>
  {%- if athlete.weightHistory.length > 1 %}
  <details class="weight-history">
    <summary>História váhy</summary>
    <ul class="weight-history-list">
      {%- for w in athlete.weightHistory %}
      <li class="weight-history-item">
        <span class="weight-history-date">{{ w.date | readableDate }}{% if w.time %} · {{ w.time }}{% endif %}</span>
        <span class="weight-history-value">{{ w.value }}</span>
      </li>
      {%- endfor %}
    </ul>
  </details>
  {%- endif %}
  {%- endif %}

  <section class="workout-coverage">
    <h3 class="page-title">Celkové pokrytie svalov</h3>
    <p class="start-here-lead">
      Všetky tréningy dokopy — výraznejšia farba znamená viac odtrénovanej
      práce. Bledé a nezafarbené miesta ukazujú, čo zanedbávam.
    </p>
    {{ bodyMap(workouts.muscleTotals) }}
    {{ bodyMapLegend() }}
  </section>

  {%- if workouts.sessions.length %}
  {%- for session in workouts.sessions %}
  <article class="workout-session">
    <header class="workout-head">
      <div class="workout-headings">
        <h3 class="workout-date">{{ session.date | readableDate }}</h3>
        {%- if session.title %}<p class="workout-title">{{ session.title }}</p>{% endif %}
      </div>
      {%- set n = session.exercises.length %}
      {%- if n %}
      <span class="workout-count">
        {%- if session.totalDuration %}<span class="workout-duration">{{ session.totalDuration }}</span
        ><span class="workout-count-sep" aria-hidden="true"> · </span>{% endif -%}
        {{ n }}&nbsp;{% if n == 1 %}cvik{% elif n >= 2 and n <= 4 %}cviky{% else %}cvikov{% endif %}</span
      >
      {%- elif session.totalDuration %}
      <span class="workout-count"><span class="workout-duration">{{ session.totalDuration }}</span></span>
      {%- endif %}
    </header>

    {%- if session.summary %}
    <p class="workout-summary">{{ session.summary }}</p>
    {%- endif %}

    {%- if session.stats.length %}
    <ul class="athlete-stats workout-session-stats">
      {%- for stat in session.stats %}
      <li class="athlete-stat">
        <span class="athlete-stat-value">{{ stat.value }}</span>
        <span class="athlete-stat-label">{{ stat.label }}</span>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}

    {%- if session.cardio.length %}
    <p class="workout-group-label">{{ session.cardioLabel or "Rozcvička a kardio" }}</p>
    <ul class="workout-list">
      {%- for ex in session.cardio %}
      <li class="workout-exercise">
        <span class="workout-ex-name">
          {{ ex.name }}
          {%- if ex.detail %}<span class="workout-ex-detail">{{ ex.detail }}</span>{% endif %}
        </span>
        <span class="workout-ex-metric">{{ ex.duration }}</span>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}

    {%- if session.strength.length %}
    <p class="workout-group-label">Silový tréning</p>
    <ul class="workout-list">
      {%- for ex in session.strength %}
      {%- if ex.setList %}
      <li class="workout-exercise workout-exercise--detailed">
        <span class="workout-ex-name">{{ ex.name }}</span>
        <ol class="workout-setlist">
          {%- for s in ex.setList %}
          <li class="workout-set">
            <span class="workout-set-metric">{{ s.reps }}&nbsp;×&nbsp;{{ s.weight }}</span>
            {%- if s.note %}<span class="workout-set-note">{{ s.note }}</span>{% endif %}
          </li>
          {%- endfor %}
        </ol>
        {%- if ex.note %}<p class="workout-ex-note">{{ ex.note }}</p>{% endif %}
      </li>
      {%- else %}
      <li class="workout-exercise">
        <span class="workout-ex-name">{{ ex.name }}</span>
        <span class="workout-ex-metric">
          <span class="workout-weight">{{ ex.weight }}</span>
          <span class="workout-sets">{{ ex.sets }}&nbsp;×&nbsp;{{ ex.reps }}</span>
        </span>
      </li>
      {%- endif %}
      {%- endfor %}
    </ul>
    {%- endif %}

    {%- if session.recovery.length %}
    <p class="workout-group-label">Regenerácia</p>
    <ul class="workout-list">
      {%- for ex in session.recovery %}
      <li class="workout-exercise">
        <span class="workout-ex-name">
          {{ ex.name }}
          {%- if ex.detail %}<span class="workout-ex-detail">{{ ex.detail }}</span>{% endif %}
        </span>
        <span class="workout-ex-metric">{{ ex.duration }}</span>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}

    {%- if session.trainsMuscles %}
    <p class="workout-group-label">Zapojené svaly</p>
    {{ bodyMap(session.muscleLevels) }}
    {%- endif %}

    {%- if session.ratings.length %}
    <p class="workout-group-label">Hodnotenie</p>
    <ul class="workout-ratings">
      {%- for r in session.ratings %}
      <li class="workout-rating">
        <div class="workout-rating-head">
          <span class="workout-rating-label"
            >{{ r.label }} <span class="workout-rating-by">— {{ r.by }}</span></span
          >
          <span class="workout-rating-score" aria-label="{{ r.score }} z 5"
            >{% for i in range(1, 6) %}<span class="star {% if i <= r.score %}star-on{% elif i - 0.5 <= r.score %}star-half{% else %}star-off{% endif %}" aria-hidden="true">★</span>{% endfor %}</span
          >
        </div>
        {%- if r.note %}<p class="workout-rating-note">{{ r.note }}</p>{% endif %}
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </article>
  {%- endfor %}
  {%- else %}
  <p class="post-list-empty">Zatiaľ žiadny záznam.</p>
  {%- endif %}
</section>

