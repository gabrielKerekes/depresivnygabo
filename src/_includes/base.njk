<!DOCTYPE html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {# Reader-mode extractors (Safari/Firefox/Brave use Readability) only strip a
       known set of title separators — | - / \ > » — so the site name is split off
       cleanly in reader view. The interpunct "·" is not recognised and would leak
       into the reader headline. #}
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="{{ author or site.author }}" />
    <!-- Apply the saved theme before first paint to avoid a flash of the wrong colours -->
    <script>
      (function () {
        var t;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        document.documentElement.setAttribute(
          "data-theme",
          t === "light" || t === "dark" ? t : "system"
        );
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/CheltenhamStdBook.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="{{ site.title }} — Atom feed"
      href="/feed.xml"
    />
    {% if site.cloudflareToken %}
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "{{ site.cloudflareToken }}"}'
    ></script>
    {% endif %}
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">
        <svg
          class="site-leaf"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
        >
          <path class="leaf-blade" d="M1 1c13 0 22 9 22 22C10 23 1 14 1 1Z" />
          <path class="leaf-vein" d="M8.6 8.6 14.9 14.9" />
        </svg>
        <span>{{ site.title }}</span>
      </a>
      <div class="header-right">
        {# No nav: the only destination left is home, and the wordmark already
           goes there. Restore a <nav> here when there are pages to link to. #}
        {# Edit shortcut → the browser editor at /edit/. On a Markdown post it
           deep-links straight to that file; everywhere else (homepage, index
           pages) it opens the post list. Hidden until JS confirms an editor
           token is stored on this device — see the reveal script below. #}
        {%- set editHref = "/edit/" -%}
        {%- if "/posts/" in page.inputPath -%}
        {%- set editHref = "/edit/?path=" + (page.inputPath | replace("./", "") | urlencode) -%}
        {%- endif -%}
        <a
          class="edit-link"
          href="{{ editHref }}"
          aria-label="Upraviť"
          title="Upraviť"
          hidden
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
        </a>
        <button type="button" class="theme-toggle" aria-label="Prepnúť tému">
          <svg
            class="icon icon-system"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
          <svg
            class="icon icon-sun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            />
          </svg>
          <svg
            class="icon icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p class="footer-contact">
        Chceš sa podeliť o svoj príbeh, prípadne len tak pokecať? Napíš mi na
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
      </p>
      <div class="footer-meta">
        <p class="footer-credit">
          So <span class="heart">&lt;3</span> vytvoril
          <a href="https://github.com/{{ site.github }}">Gabo</a>
        </p>
        <nav class="footer-links" aria-label="Odkazy v pätičke">
          <a href="https://github.com/{{ site.github }}/depresivnygabo">zdrojový kód na GitHube</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href="/feed.xml">RSS</a>
        </nav>
      </div>
    </footer>

    <!-- Reveal the edit shortcut only on devices where an editor token is
         stored (same key the /edit/ page uses). Visitors never see it. -->
    <script>
      (function () {
        var link = document.querySelector(".edit-link");
        if (!link) return;
        try {
          if (localStorage.getItem("gh_editor_token")) link.hidden = false;
        } catch (e) {}
      })();
    </script>

    <script>
      (function () {
        var btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        var root = document.documentElement;
        var order = ["system", "light", "dark"];
        var labels = {
          system: "Téma: podľa systému",
          light: "Téma: svetlá",
          dark: "Téma: tmavá"
        };

        function apply(mode) {
          root.setAttribute("data-theme", mode);
          btn.setAttribute("aria-label", labels[mode]);
          btn.setAttribute("title", labels[mode]);
          try {
            localStorage.setItem("theme", mode);
          } catch (e) {}
        }

        // Sync the label with whatever the head script already applied
        var current = root.getAttribute("data-theme");
        if (order.indexOf(current) === -1) current = "system";
        btn.setAttribute("aria-label", labels[current]);
        btn.setAttribute("title", labels[current]);

        btn.addEventListener("click", function () {
          apply(order[(order.indexOf(current) + 1) % order.length]);
          current = root.getAttribute("data-theme");
        });
      })();
    </script>
  </body>
</html>
