<!DOCTYPE html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {# Reader-mode extractors (Safari/Firefox/Brave use Readability) only strip a
       known set of title separators — | - / \ > » — so the site name is split off
       cleanly in reader view. The interpunct "·" is not recognised and would leak
       into the reader headline. #}
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="{{ author or site.author }}" />
    <!-- Apply the saved theme before first paint to avoid a flash of the wrong colours -->
    <script>
      (function () {
        var t;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        document.documentElement.setAttribute(
          "data-theme",
          t === "light" || t === "dark" ? t : "system"
        );
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/CheltenhamStdBook.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="{{ site.title }} — Atom feed"
      href="/feed.xml"
    />
    {% if site.cloudflareToken %}
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "{{ site.cloudflareToken }}"}'
    ></script>
    {% endif %}
  </head>
  <body id="top">
    <a class="skip" href="#obsah">Preskočiť na obsah</a>
    {% include "plants.njk" %}
    {# Fixed bar in the page's own vocabulary: italic serif wordmark, tracked
       small-caps links with the green kicker dash, a hairline inside the
       gutter. It gains a frosted backdrop once the page scrolls. #}
    <header class="bar" id="bar">
      <div class="bar-in">
        <a class="brand" href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="leaf-blade" d="M1 1c13 0 22 9 22 22C10 23 1 14 1 1Z" />
            <path class="leaf-vein" d="M8.6 8.6 14.9 14.9" />
          </svg>
          <span>{{ site.title }}</span>
        </a>
        <nav aria-label="Hlavná navigácia">
          <a href="/#clanky" data-spy="clanky">Články</a>
          {%- if collections.trvalka.length %}
          <a href="/#trvalky" data-spy="trvalky">Trvalky</a>
          {%- endif %}
          <a href="/kto-som/" class="hide-sm">Kto som</a>
          {# Edit shortcut → the browser editor at /edit/. On a Markdown post it
             deep-links straight to that file; everywhere else (homepage, index
             pages) it opens the post list. Hidden until JS confirms an editor
             token is stored on this device — see the reveal script below. #}
          {%- set editHref = "/edit/" -%}
          {%- if "/posts/" in page.inputPath -%}
          {%- set editHref = "/edit/?path=" + (page.inputPath | replace("./", "") | urlencode) -%}
          {%- endif %}
          <a class="edit-link" href="{{ editHref }}" aria-label="Upraviť" title="Upraviť" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
            </svg>
          </a>
          <button type="button" class="theme" aria-label="Prepnúť tému">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="7.5" />
              <path d="M12 4.5v15A7.5 7.5 0 0 0 12 4.5Z" fill="currentColor" stroke="none" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="obsah" class="{{ 'full' if fullBleed else 'page' }}">
      {{ content | safe }}
    </main>

    {# Always night — the garden glows. One plant per post (sized by its growth
       stage), then a flower per trvalka. #}
    <footer class="foot night">
      <div class="foot-inner">
        <p class="foot-kicker">Chceš sa ozvať?</p>
        <a class="foot-big" href="mailto:{{ site.email }}">napíš mi!<span class="arr" aria-hidden="true">↗</span></a>
        <span class="foot-mail">{{ site.email }}</span>

        <div class="garden" role="list" aria-label="Záhradka — každá rastlinka je jeden text">
          {%- for post in collections.post %}
          {%- set st = post.data.stage or "seedling" %}
          <a role="listitem" href="{{ post.url }}" style="--c: var(--stage-{{ st }}); --i: {{ loop.index0 }}" data-t="{{ post.data.title }}">
            <svg viewBox="0 2 24 30" aria-hidden="true"><use href="#st-{{ st }}" /></svg>
            <span class="sr-only">{{ post.data.title }}</span>
          </a>
          {%- endfor %}
          <span class="spacer" aria-hidden="true"></span>
          {%- for t in collections.trvalka %}
          <a role="listitem" href="{{ t.url }}" style="--c: var(--accent-strong); --i: {{ collections.post.length + loop.index0 }}" data-t="{{ t.data.title }}">
            <svg viewBox="0 2 24 30" aria-hidden="true"><use href="#st-flower" /></svg>
            <span class="sr-only">Trvalka: {{ t.data.title }}</span>
          </a>
          {%- endfor %}
        </div>
        <p class="garden-cap">
          <span>Záhradka: {{ collections.post.length | skCount("článok", "články", "článkov") }}
            a {{ collections.trvalka.length | skCount("trvalka", "trvalky", "trvaliek") }}.
            Každá rastlinka je jeden text.</span>
          {%- if collections.post.length %}
          <span>od {{ (collections.post[0].date | readableDate).split(". ")[1] }} →</span>
          {%- endif %}
        </p>

        <div class="foot-base">
          <p>So <span class="heart">&lt;3</span> vytvoril <a href="https://github.com/{{ site.github }}">Gabo</a></p>
          <nav aria-label="Odkazy v pätičke">
            <a href="https://github.com/{{ site.github }}/depresivnygabo">zdrojový kód na GitHube</a>
            <a href="/feed.xml">RSS</a>
            <a href="#top">hore ↑</a>
          </nav>
        </div>
      </div>
    </footer>

    <!-- Reveal the edit shortcut only on devices where an editor token is
         stored (same key the /edit/ page uses). Visitors never see it. -->
    <script>
      (function () {
        var link = document.querySelector(".edit-link");
        if (!link) return;
        try {
          if (localStorage.getItem("gh_editor_token")) link.hidden = false;
        } catch (e) {}
      })();
    </script>

    <script>
      (function () {
        var btn = document.querySelector(".bar .theme");
        if (!btn) return;
        var root = document.documentElement;
        var order = ["system", "light", "dark"];
        var labels = {
          system: "Téma: podľa systému",
          light: "Téma: svetlá",
          dark: "Téma: tmavá"
        };

        function apply(mode) {
          root.setAttribute("data-theme", mode);
          btn.setAttribute("aria-label", labels[mode]);
          btn.setAttribute("title", labels[mode]);
          try {
            localStorage.setItem("theme", mode);
          } catch (e) {}
        }

        // Sync the label with whatever the head script already applied
        var current = root.getAttribute("data-theme");
        if (order.indexOf(current) === -1) current = "system";
        btn.setAttribute("aria-label", labels[current]);
        btn.setAttribute("title", labels[current]);

        btn.addEventListener("click", function () {
          apply(order[(order.indexOf(current) + 1) % order.length]);
          current = root.getAttribute("data-theme");
        });
      })();
    </script>

    <script>
      (function () {
        // The bar gets its backdrop once you leave the top.
        var bar = document.getElementById("bar");
        function onScroll() {
          bar.classList.toggle("scrolled", window.scrollY > 24);
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        // Mark the nav link of the homepage section in view.
        var spies = document.querySelectorAll(".bar [data-spy]");
        if (!("IntersectionObserver" in window)) return;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              spies.forEach(function (a) {
                if (a.dataset.spy === e.target.id)
                  a.classList.toggle("is-here", e.isIntersecting);
              });
            });
          },
          { rootMargin: "-45% 0px -50% 0px" }
        );
        spies.forEach(function (a) {
          var s = document.getElementById(a.dataset.spy);
          if (s) io.observe(s);
        });
      })();
    </script>
  </body>
</html>
