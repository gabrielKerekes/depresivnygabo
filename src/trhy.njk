---
layout: base.njk
title: Trhy
# A "trvalka" (perennial) — a standing reference page. Listed on the homepage
# and at /trvalky/. Prices are fetched at build time (src/_data/markets.js) and
# the site rebuilds daily. To track another ticker, add a line to
# src/_data/tickers.json.
permalink: /trhy/
tags:
  - trvalka
description: Akcie a kryptomeny, ktoré sledujem — vývoj cien vedľa seba.
kind: prehľad # one-word label on the homepage card
---
<style>
  /* Scoped to this page. Series colours are a validated categorical palette,
     stepped separately for light and dark surfaces. */
  .mk {
    --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100;
    --s5: #e87ba4; --s6: #008300; --s7: #6250d6; --s8: #e34948;
    --up: #2f8a4f; --down: #d0453f;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .mk {
      --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500;
      --s5: #d55181; --s6: #008300; --s7: #9085e9; --s8: #e66767;
      --up: #6cc788; --down: #ef7a72;
    }
  }
  :root[data-theme="dark"] .mk {
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500;
    --s5: #d55181; --s6: #008300; --s7: #9085e9; --s8: #e66767;
    --up: #6cc788; --down: #ef7a72;
  }

  .mk-lead {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .mk-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-family: var(--sans);
  }
  .mk-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  /* Range: one segmented control. */
  .mk-ranges {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .mk-ranges button {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    min-width: 2.6rem;
    padding: 0.35rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .mk-ranges button[aria-pressed="true"] {
    background: var(--accent-soft);
    color: var(--fg);
  }

  /* Ticker chips double as the legend. */
  .mk-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    cursor: pointer;
  }
  .mk-chip svg { width: 18px; height: 8px; flex: none; }
  .mk-chip[aria-pressed="false"] {
    color: var(--muted);
    background: none;
  }
  .mk-chip[aria-pressed="false"] svg { opacity: 0.3; }
  .mk-group {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.3rem 0.5rem;
    border: 0;
    background: none;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .mk-group:hover, .mk-chip:hover, .mk-ranges button:hover { color: var(--fg); }

  .mk-chart {
    position: relative;
    margin: 0 0 1.5rem;
    padding: 0.75rem 0.25rem 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    touch-action: pan-y;
    /* Holding a finger on the chart should scrub, not select text or open
       the long-press menu (which also steals the touch and hides the tip). */
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .mk-chart svg { display: block; width: 100%; }
  .mk-chart text {
    font-family: var(--sans);
    font-size: 11px;
    fill: var(--muted);
  }
  .mk-chart .grid { stroke: var(--border); stroke-width: 1; }
  .mk-chart .zero { stroke: var(--muted); stroke-width: 1; opacity: 0.6; }
  .mk-chart .line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .mk-chart .end-label { font-weight: 600; fill: var(--fg); }
  .mk-chart .cross { stroke: var(--muted); stroke-width: 1; }
  .mk-chart .dot { stroke: var(--surface); stroke-width: 2; }
  /* $ mode with two axes: each axis names the tickers it carries. */
  .mk-chart .axis-key { font-weight: 600; fill: var(--fg); }
  .mk-mode button, .mk-axes button { min-width: 2.2rem; }

  .mk-empty {
    padding: 4rem 1rem;
    text-align: center;
    color: var(--muted);
    font-family: var(--sans);
  }

  .mk-tip {
    position: absolute;
    top: 0.5rem;
    z-index: 2;
    min-width: 11rem;
    padding: 0.55rem 0.7rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 6px 18px var(--shadow);
    pointer-events: none;
  }
  .mk-tip-date { color: var(--muted); margin-bottom: 0.2rem; }
  .mk-tip-row { display: flex; align-items: center; gap: 0.5rem; }
  .mk-tip-row svg { width: 14px; height: 6px; flex: none; }
  .mk-tip-row b { font-weight: 600; min-width: 3.2rem; }
  .mk-tip-row span:last-child { margin-left: auto; font-variant-numeric: tabular-nums; }

  /* Quote list, in the spirit of a stocks app: ticker, sparkline, price. */
  .mk-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--sans);
    border-top: 1px solid var(--border);
  }
  .mk-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(70px, 26%, 160px) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0.85rem 0.25rem;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: none;
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .mk-item[aria-pressed="false"] { opacity: 0.4; }
  .mk-item:hover { background: var(--accent-soft); }
  .mk-sym { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
  .mk-sym svg { width: 18px; height: 8px; flex: none; }
  .mk-sym > span { min-width: 0; }
  .mk-sym b { display: block; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.01em; }
  .mk-sym small {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mk-spark { width: 100%; height: 38px; display: block; overflow: visible; }
  .mk-spark .base { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.6; }
  .mk-spark .up { stroke: var(--up); }
  .mk-spark .down { stroke: var(--down); }
  .mk-quote { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; }
  .mk-price { font-size: 1.02rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .mk-pill {
    min-width: 4.8rem;
    padding: 0.18rem 0.5rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }
  .mk-pill.up { background: var(--up); }
  .mk-pill.down { background: var(--down); }
  :root[data-theme="dark"] .mk-pill { color: #101216; }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .mk-pill { color: #101216; }
  }

  /* Focus one ticker (hover a chip or a row): the rest step back. */
  .mk-chart.has-focus .line { opacity: 0.12; }
  .mk-chart.has-focus .line.on { opacity: 1; stroke-width: 2.75; }

  .mk-span {
    margin: 0 0 0.5rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .mk-note {
    margin-top: 1rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ---- Market weather ---------------------------------------------------
     Five levels, calm green → red. Each level always ships with its icon and
     name, so colour is never the only cue. */
  .mk {
    --w0: #3f9a5f; --w1: #8fae2e; --w2: #d29a00; --w3: #e0702a; --w4: #d0453f;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .mk {
      --w0: #6cc788; --w1: #b5cf5a; --w2: #e5b44a; --w3: #ef8a4a; --w4: #ef7a72;
    }
  }
  :root[data-theme="dark"] .mk {
    --w0: #6cc788; --w1: #b5cf5a; --w2: #e5b44a; --w3: #ef8a4a; --w4: #ef7a72;
  }
  .mk-weather {
    --lvl: var(--w0);
    position: relative;
    margin: 0 0 2.25rem;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--border);
    border-top: 3px solid var(--lvl);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--lvl) 14%, transparent), transparent 60%),
      var(--surface);
    font-family: var(--sans);
  }
  .mk-weather.l1 { --lvl: var(--w1); }
  .mk-weather.l2 { --lvl: var(--w2); }
  .mk-weather.l3 { --lvl: var(--w3); }
  .mk-weather.l4 { --lvl: var(--w4); }
  .mk-w-head { display: flex; align-items: center; gap: 1rem; }
  .mk-w-icon { font-size: 3.2rem; line-height: 1; flex: none; }
  .mk-w-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mk-w-name {
    margin: 0.1rem 0 0.15rem;
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--fg);
  }
  .mk-w-text { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .mk-w-dots { display: inline-flex; gap: 0.25rem; }
  .mk-w-dot.s1 { background: var(--w2); }
  .mk-w-dot.s2 { background: var(--w3); }
  .mk-w-dot.s3 { background: var(--w4); }
  /* Sub-forecast tiles: tap one to open its breakdown below. */
  .mk-w-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .mk-w-tile {
    --lvl: var(--w0);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--lvl);
    border-radius: 10px;
    background: color-mix(in srgb, var(--lvl) 8%, var(--surface));
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s, box-shadow 0.15s;
  }
  .mk-w-tile.l1 { --lvl: var(--w1); }
  .mk-w-tile.l2 { --lvl: var(--w2); }
  .mk-w-tile.l3 { --lvl: var(--w3); }
  .mk-w-tile.l4 { --lvl: var(--w4); }
  .mk-w-tile:hover { background: color-mix(in srgb, var(--lvl) 15%, var(--surface)); }
  .mk-w-tile[aria-expanded="true"] {
    background: color-mix(in srgb, var(--lvl) 15%, var(--surface));
    box-shadow: 0 0 0 1px var(--lvl);
  }
  .mk-w-tile-icon { font-size: 1.9rem; line-height: 1; flex: none; }
  .mk-w-tile-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .mk-w-tile-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .mk-w-tile-name { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; line-height: 1.15; }
  .mk-w-tile .mk-w-dots { margin-top: 0.2rem; }
  .mk-w-tile .mk-w-dot { width: 0.45rem; height: 0.45rem; }
  .mk-w-chev {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    margin-left: auto;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.15s;
  }
  .mk-w-tile[aria-expanded="true"] .mk-w-chev { transform: rotate(225deg); }

  .mk-w-detail {
    margin-top: 0.9rem;
    padding: 0.9rem 0 0.2rem;
    border-top: 1px solid var(--border);
  }
  .mk-w-detail-head { margin: 0 0 0.6rem; font-size: 0.9rem; color: var(--muted); }
  .mk-w-detail-head b { color: var(--fg); font-weight: 600; }
  .mk-w-detail .mk-w-history { margin-top: 0.9rem; }
  .mk-w-signals {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .mk-w-signal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 0.65rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
  }
  .mk-w-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--w0);
    transform: translateY(-0.05rem);
  }
  .mk-w-signal.s1 .mk-w-dot { background: var(--w2); }
  .mk-w-signal.s2 .mk-w-dot { background: var(--w3); }
  .mk-w-signal.s3 .mk-w-dot { background: var(--w4); }
  .mk-w-signal b { font-weight: 600; color: var(--fg); }
  .mk-w-note { display: block; color: var(--muted); font-size: 0.8rem; }
  .mk-w-value {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    text-align: right;
    font-size: 0.82rem;
  }

  .mk-w-history { margin-top: 1.1rem; }
  .mk-w-history-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .mk-w-strip {
    display: block;
    width: 100%;
    height: 34px;
    border-radius: 6px;
    overflow: hidden;
    cursor: crosshair;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  .mk-w-strip rect.l0 { fill: var(--w0); }
  .mk-w-strip rect.l1 { fill: var(--w1); }
  .mk-w-strip rect.l2 { fill: var(--w2); }
  .mk-w-strip rect.l3 { fill: var(--w3); }
  .mk-w-strip rect.l4 { fill: var(--w4); }
  .mk-w-strip .mark { fill: var(--fg); }
  .mk-w-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.3rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .mk-w-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.76rem;
    color: var(--muted);
  }
  .mk-w-legend li { display: inline-flex; align-items: center; gap: 0.35rem; }
  .mk-w-legend i { width: 0.7rem; height: 0.7rem; border-radius: 3px; display: inline-block; }
  .mk-w-show {
    margin-top: 0.9rem;
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    border: 0;
    background: none;
    color: var(--accent);
    cursor: pointer;
  }
  .mk-w-show:hover { color: var(--accent-strong); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 560px) {
    .mk-weather { padding: 1rem 1rem 0.85rem; }
    .mk-w-icon { font-size: 2.6rem; }
    .mk-w-name { font-size: 1.7rem; }
    .mk-w-signal { grid-template-columns: auto minmax(0, 1fr); }
    .mk-w-tiles { gap: 0.5rem; }
    .mk-w-tile { padding: 0.6rem 0.6rem; gap: 0.5rem; }
    .mk-w-tile-icon { font-size: 1.5rem; }
    .mk-w-tile-name { font-size: 1.05rem; }
    .mk-w-value { grid-column: 2; text-align: left; color: var(--muted); }
  }

  @media (max-width: 560px) {
    .mk-tip { min-width: 0; padding: 0.4rem 0.55rem; font-size: 0.72rem; line-height: 1.4; }
    .mk-tip-price { display: none; }
    .mk-chart.is-usd .mk-tip-price { display: inline; }
    .mk-chart.is-usd .mk-tip-pct { display: none; }
    .mk-item { gap: 0.75rem; }
  }
</style>

<section class="mk">
  <h2 class="page-title">Trhy</h2>
  {#- One year of daily weather as a colour strip; tap/hover reads a day. #}
  {%- macro weatherStrip(hist, label) %}
  <div class="mk-w-history">
    <div class="mk-w-history-head">
      <span>{{ label }}</span>
      <span class="mk-w-pick" aria-live="polite"></span>
    </div>
    <svg class="mk-w-strip" viewBox="0 0 {{ hist.length }} 10" preserveAspectRatio="none" role="img" aria-label="{{ label }}">
      {%- for h in hist %}
      <rect class="l{{ h.level }}" x="{{ loop.index0 }}" y="0" width="1.05" height="10" data-d="{{ h.date }}" data-l="{{ h.level }}" />
      {%- endfor %}
    </svg>
    <div class="mk-w-axis"><span>{{ hist[0].date }}</span><span>dnes</span></div>
  </div>
  {%- endmacro %}

  {%- set w = markets.mood %}
  {%- if w %}
  <section class="mk-weather l{{ w.level }}" aria-labelledby="mk-w-name">
    <div class="mk-w-head">
      <span class="mk-w-icon" aria-hidden="true">{{ w.icon }}</span>
      <div>
        <p class="mk-w-kicker">Počasie na trhu · {{ w.date }}</p>
        <p class="mk-w-name" id="mk-w-name">{{ w.name }}</p>
        <p class="mk-w-text">{{ w.text }}</p>
      </div>
    </div>

    {%- if w.groups.length > 1 %}
    <div class="mk-w-tiles">
      {%- for g in w.groups %}
      <button type="button" class="mk-w-tile l{{ g.level }}" aria-expanded="false" aria-controls="mk-w-g-{{ g.id }}">
        <span class="mk-w-tile-icon" aria-hidden="true">{{ g.icon }}</span>
        <span class="mk-w-tile-body">
          <span class="mk-w-tile-title">{{ g.title }}</span>
          <span class="mk-w-tile-name">{{ g.name }}</span>
          <span class="mk-w-dots" aria-hidden="true">
            {%- for sig in g.signals %}<span class="mk-w-dot s{{ sig.score }}"></span>{%- endfor %}
          </span>
        </span>
        <span class="mk-w-chev" aria-hidden="true"></span>
      </button>
      {%- endfor %}
    </div>
    {%- endif %}

    {%- for g in w.groups %}
    <div class="mk-w-detail" id="mk-w-g-{{ g.id }}" {% if w.groups.length > 1 %}hidden{% endif %}>
      <p class="mk-w-detail-head">
        <b>{{ g.icon }} {{ g.title }}: {{ g.name | lower }}.</b> {{ g.text }}
      </p>
      <ul class="mk-w-signals">
        {%- for sig in g.signals %}
        <li class="mk-w-signal s{{ sig.score }}">
          <span class="mk-w-dot" aria-hidden="true"></span>
          <span><b>{{ sig.name }}</b><span class="mk-w-note">{{ sig.note }}</span></span>
          <span class="mk-w-value">{{ sig.value }}</span>
        </li>
        {%- endfor %}
      </ul>
      {{ weatherStrip(g.history, g.title + " za posledný rok") }}
      <button type="button" class="mk-w-show"
        data-syms="{{ ('SPY,^VIX,HYG,TLT,GLD' if g.id == 'fiat' else 'BTC-USD,ETH-USD,SOL-USD,ADA-USD') }}">Ukáž v grafe →</button>
    </div>
    {%- endfor %}

    {{ weatherStrip(w.history, "Celkové počasie za posledný rok") }}
    <ul class="mk-w-legend">
      {%- for lv in w.levels %}
      <li><i style="background: var(--w{{ loop.index0 }})"></i>{{ lv.icon }} {{ lv.name }}</li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <p class="mk-lead">
    Akcie a kryptomeny, ktoré sledujem. V režime % graf ukazuje, o koľko sa
    každá cena pohla od začiatku obdobia — tak sa dajú porovnať aj Bitcoin za
    77 000 a Cardano za pár centov. V režime $ ukazuje skutočné ceny.
  </p>

  <div class="mk-controls">
    <div class="mk-row">
      <div class="mk-ranges" role="group" aria-label="Obdobie">
        <button type="button" data-range="7">1T</button>
        <button type="button" data-range="30">1M</button>
        <button type="button" data-range="91">3M</button>
        <button type="button" data-range="182">6M</button>
        <button type="button" data-range="ytd">Od 1.1.</button>
        <button type="button" data-range="365">1R</button>
        <button type="button" data-range="1826">5R</button>
      </div>
      <div class="mk-ranges mk-mode" role="group" aria-label="Zobrazenie">
        <button type="button" data-mode="pct" title="Zmena v percentách">%</button>
        <button type="button" data-mode="usd" title="Cena v dolároch">$</button>
      </div>
      <div class="mk-ranges mk-axes" role="group" aria-label="Osi" hidden>
        <button type="button" data-axes="1" title="Všetky ceny na jednej osi">1 os</button>
        <button type="button" data-axes="2" title="Lacnejšie tituly vľavo, drahšie vpravo">2 osi</button>
      </div>
    </div>
    <div class="mk-row" id="mk-chips" role="group" aria-label="Zobrazené tituly"></div>
    <div class="mk-row" id="mk-groups"></div>
  </div>

  <p class="mk-span" id="mk-span" aria-live="polite"></p>
  <div class="mk-chart" id="mk-chart">
    <p class="mk-empty">Načítavam ceny…</p>
  </div>

  <ul class="mk-list" id="mk-list" aria-label="Kurzy"></ul>

  <p class="mk-note" id="mk-note">
    Denné záverečné ceny z Yahoo Finance, v USD (VIX je index, nie cena). Aktualizuje sa raz denne.
  </p>
</section>

<script>
  (function () {
    var DAY = 86400000;
    var STORE = "trhy:v1";
    var GROUP_NAMES = { trh: "celý trh", krypto: "krypto", akcie: "akcie" };

    var state = { range: "30", hidden: [], mode: "pct", axes: "1" };
    try {
      var saved = JSON.parse(localStorage.getItem(STORE) || "null");
      if (saved && saved.range) state = saved;
      if (state.mode !== "usd") state.mode = "pct";
      if (state.axes !== "2") state.axes = "1";
    } catch (e) {}
    function save() {
      try { localStorage.setItem(STORE, JSON.stringify(state)); } catch (e) {}
    }

    var chartEl = document.getElementById("mk-chart");
    var listEl = document.getElementById("mk-list");
    var series = [];
    var lastRender = null;

    // ---- formatting --------------------------------------------------------
    function dateOf(day) { return new Date(day * DAY); }
    function fmtDate(day, opts) {
      return dateOf(day).toLocaleDateString("sk-SK", Object.assign({ timeZone: "UTC" }, opts));
    }
    function fmtPrice(v) {
      var digits = v >= 1000 ? 0 : v >= 1 ? 2 : 4;
      if (v < 1) return v.toLocaleString("sk-SK", { maximumSignificantDigits: 4 });
      return v.toLocaleString("sk-SK", { minimumFractionDigits: digits, maximumFractionDigits: digits });
    }
    function fmtPct(p) {
      var abs = Math.abs(p);
      var s = abs.toLocaleString("sk-SK", { maximumFractionDigits: abs >= 100 ? 0 : 1, minimumFractionDigits: abs >= 100 ? 0 : 1 });
      return (p > 0 ? "+" : p < 0 ? "−" : "") + s + " %";
    }

    // Colour follows the ticker's position in tickers.json, never what's on
    // screen. Past eight tickers the hues repeat with a dashed line.
    function styleOf(i) {
      return { color: "var(--s" + ((i % 8) + 1) + ")", dash: Math.floor(i / 8) % 2 ? "6 4" : "" };
    }
    function swatch(s, w, h) {
      return '<svg viewBox="0 0 ' + w + " " + h + '" aria-hidden="true"><line x1="1" y1="' + h / 2 + '" x2="' + (w - 1) + '" y2="' + h / 2 +
        '" stroke="' + s.style.color + '" stroke-width="3" stroke-linecap="round"' + (s.style.dash ? ' stroke-dasharray="4 3"' : "") + "/></svg>";
    }
    function esc(t) {
      return String(t).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; });
    }

    // ---- data shaping ------------------------------------------------------
    function rangeStart(lastDay) {
      if (state.range === "ytd") {
        var y = dateOf(lastDay).getUTCFullYear();
        return Math.floor(Date.UTC(y, 0, 1) / DAY) - 1; // last close of the previous year
      }
      return lastDay - Number(state.range);
    }

    // Slice one ticker to the range. The baseline is the last close at or
    // before the range start (or the first close, for younger tickers).
    function slice(s, start) {
      var i = 0;
      while (i < s.days.length && s.days[i] < start) i++;
      var from = Math.max(0, s.days[i] === start ? i : i - 1);
      var days = s.days.slice(from), prices = s.prices.slice(from);
      var base = prices[0];
      return {
        days: days,
        prices: prices,
        pct: prices.map(function (p) { return (p / base - 1) * 100; }),
      };
    }

    // ---- controls ----------------------------------------------------------
    function buildControls() {
      var chips = document.getElementById("mk-chips");
      chips.innerHTML = series.map(function (s) {
        return '<button type="button" class="mk-chip" data-sym="' + esc(s.symbol) + '" title="' + esc(s.name) + '">' +
          swatch(s, 18, 8) + esc(s.label) + "</button>";
      }).join("");
      chips.addEventListener("click", function (e) {
        var b = e.target.closest(".mk-chip");
        if (!b) return;
        var sym = b.dataset.sym;
        var i = state.hidden.indexOf(sym);
        if (i === -1) state.hidden.push(sym); else state.hidden.splice(i, 1);
        update();
      });

      // Quick filters. One "Len …" per group, then a few cross-cutting ones:
      // "Len ETF" (tickers marked "etf": true) and "Bez krypta" (no crypto,
      // no indices).
      var groups = [];
      series.forEach(function (s) { if (s.group && groups.indexOf(s.group) === -1) groups.push(s.group); });
      var filters = [{ label: "Všetko", keep: function () { return true; } }];
      groups.forEach(function (name) {
        filters.push({ label: "Len " + (GROUP_NAMES[name] || name).toLowerCase(), keep: function (s) { return s.group === name; } });
        if (name === "trh" && series.some(function (s) { return s.etf; })) {
          filters.push({ label: "Len ETF", keep: function (s) { return !!s.etf; } });
        }
      });
      if (groups.indexOf("krypto") !== -1 && groups.length > 1) {
        // ETFs and stocks: everything except crypto and indices like VIX.
        filters.push({ label: "Bez krypta", keep: function (s) { return s.group !== "krypto" && s.symbol.charAt(0) !== "^"; } });
      }
      var g = document.getElementById("mk-groups");
      g.innerHTML = filters.map(function (f, i) {
        return '<button type="button" class="mk-group" data-f="' + i + '">' + esc(f.label) + "</button>";
      }).join("");
      g.addEventListener("click", function (e) {
        var b = e.target.closest(".mk-group");
        if (!b) return;
        var f = filters[+b.dataset.f];
        state.hidden = series.filter(function (s) { return !f.keep(s); })
          .map(function (s) { return s.symbol; });
        update();
      });

      document.querySelector(".mk-mode").addEventListener("click", function (e) {
        var b = e.target.closest("button");
        if (!b) return;
        state.mode = b.dataset.mode;
        update();
      });

      document.querySelector(".mk-axes").addEventListener("click", function (e) {
        var b = e.target.closest("button");
        if (!b) return;
        state.axes = b.dataset.axes;
        update();
      });

      document.querySelector(".mk-ranges").addEventListener("click", function (e) {
        var b = e.target.closest("button");
        if (!b) return;
        state.range = b.dataset.range;
        update();
      });
    }

    // ---- chart -------------------------------------------------------------
    function niceStep(span, count) {
      var raw = span / count, mag = Math.pow(10, Math.floor(Math.log10(raw)));
      var n = raw / mag;
      return (n >= 5 ? 10 : n >= 2 ? 5 : n >= 1 ? 2 : 1) * mag;
    }

    function drawChart(visible, start, end) {
      var W = chartEl.clientWidth - 8;
      var H = W < 560 ? 320 : 400;
      var usd = state.mode === "usd";
      var dual = usd && state.axes === "2" && visible.length > 1;
      var val = usd ? function (v, i) { return v.r.prices[i]; } : function (v, i) { return v.r.pct[i]; };
      visible.forEach(function (v) { v.axis = 0; });
      if (dual) splitAxes(visible);
      var fewLabels = visible.length <= 4 && !dual;

      // One scale per axis: % always includes the 0 baseline; $ fits the data.
      var axes = [0, 1].map(function (a) {
        var lo = usd ? Infinity : 0, hi = usd ? -Infinity : 0;
        visible.forEach(function (v) {
          if (v.axis !== a) return;
          v.r.days.forEach(function (_, i) { var p = val(v, i); if (p < lo) lo = p; if (p > hi) hi = p; });
        });
        if (lo === Infinity) return null;
        if (hi - lo < (usd ? Math.abs(hi) * 0.01 + 1e-9 : 1)) { var pad = usd ? Math.abs(hi) * 0.01 + 1e-6 : 0.5; hi += pad; lo -= pad; }
        var step = niceStep(hi - lo, W < 560 ? 4 : 5);
        lo = Math.floor(lo / step) * step;
        hi = Math.ceil(hi / step) * step;
        if (usd && lo < 0) lo = 0;
        var label = usd
          ? function (t) { return axisLabel(t, step); }
          : function (t) { return Math.abs(t) < step / 1000 ? "0 %" : fmtPct(t).replace(",0 ", " "); };
        return { lo: lo, hi: hi, step: step, label: label };
      });

      // Margins fit the widest tick label (~6.2px per character at 11px).
      function widest(A) { return A ? Math.max(A.label(A.lo).length, A.label(A.hi).length) : 0; }
      var m = {
        t: dual ? 24 : 10,
        r: axes[1] ? Math.round(widest(axes[1]) * 6.2 + 14) : fewLabels ? 52 : 14,
        b: 26,
        l: Math.round(widest(axes[0]) * 6.2 + 12),
      };
      var iw = W - m.l - m.r, ih = H - m.t - m.b;

      var x = function (d) { return m.l + ((d - start) / (end - start)) * iw; };
      var yAx = function (a, p) { var A = axes[a]; return m.t + (1 - (p - A.lo) / (A.hi - A.lo)) * ih; };
      var yOf = function (v, i) { return yAx(v.axis, val(v, i)); };

      var out = '<svg viewBox="0 0 ' + W + " " + H + '" height="' + H + '" role="img" aria-label="' +
        (usd ? "Ceny v dolároch" : "Percentuálna zmena cien") + ' za zvolené obdobie">';

      // Gridlines follow the left axis; the right axis only gets labels.
      axes.forEach(function (A, a) {
        if (!A) return;
        for (var v = A.lo; v <= A.hi + A.step / 2; v += A.step) {
          var yy = yAx(a, v).toFixed(1);
          if (a === 0) {
            var zero = !usd && Math.abs(v) < A.step / 1000;
            out += '<line class="' + (zero ? "zero" : "grid") + '" x1="' + m.l + '" x2="' + (m.l + iw) + '" y1="' + yy + '" y2="' + yy + '"/>';
            out += '<text x="' + (m.l - 8) + '" y="' + yy + '" dy="0.32em" text-anchor="end">' + esc(A.label(v)) + "</text>";
          } else {
            out += '<text x="' + (m.l + iw + 8) + '" y="' + yy + '" dy="0.32em" text-anchor="start">' + esc(A.label(v)) + "</text>";
          }
        }
      });

      // With two axes, name what each one carries, above it.
      if (dual) {
        [0, 1].forEach(function (a) {
          var names = visible.filter(function (v) { return v.axis === a; }).map(function (v) { return v.s.label; });
          var txt = (a ? "" : "← ") + names.join(", ") + (a ? " →" : "");
          out += '<text class="axis-key" x="' + (a ? m.l + iw + m.r - 4 : 4) + '" y="12" text-anchor="' + (a ? "end" : "start") + '">' + esc(txt) + "</text>";
        });
      }

      // X labels: a handful of evenly spaced dates
      var span = end - start;
      var opts = span <= 120 ? { day: "numeric", month: "numeric" } : span <= 250 ? { month: "short" } : { month: "numeric", year: "numeric" };
      var ticks = W < 560 ? 3 : 5;
      for (var k = 0; k <= ticks; k++) {
        var d = Math.round(start + (span * k) / ticks);
        var anchor = k === 0 ? "start" : k === ticks ? "end" : "middle";
        out += '<text x="' + x(d).toFixed(1) + '" y="' + (H - 6) + '" text-anchor="' + anchor + '">' + esc(fmtDate(d, opts)) + "</text>";
      }

      // Lines
      visible.forEach(function (v) {
        var dpath = v.r.days.map(function (d, i) {
          return (i ? "L" : "M") + x(Math.max(d, start)).toFixed(1) + " " + yOf(v, i).toFixed(1);
        }).join("");
        out += '<path class="line" data-sym="' + esc(v.s.symbol) + '" d="' + dpath + '" stroke="' + v.s.style.color + '"' +
          (v.s.style.dash ? ' stroke-dasharray="' + v.s.style.dash + '"' : "") + "/>";
      });

      // Direct end labels when there are few enough lines to read them
      if (fewLabels) {
        var labels = visible.map(function (v) {
          return { text: v.s.label, y: yOf(v, v.r.days.length - 1) };
        }).sort(function (a, b) { return a.y - b.y; });
        for (var j = 1; j < labels.length; j++) {
          if (labels[j].y - labels[j - 1].y < 13) labels[j].y = labels[j - 1].y + 13;
        }
        // If the stack runs off the bottom, push just the crowded ones back up.
        var n = labels.length;
        if (n && labels[n - 1].y > m.t + ih) {
          labels[n - 1].y = m.t + ih;
          for (var q = n - 2; q >= 0; q--) {
            if (labels[q + 1].y - labels[q].y < 13) labels[q].y = labels[q + 1].y - 13;
          }
        }
        labels.forEach(function (l) {
          out += '<text class="end-label" x="' + (m.l + iw + 6) + '" y="' + l.y.toFixed(1) + '" dy="0.32em">' + esc(l.text) + "</text>";
        });
      }

      out += '<g id="mk-hover" style="display:none"><line class="cross" y1="' + m.t + '" y2="' + (m.t + ih) + '"/></g>';
      out += '<rect x="' + m.l + '" y="0" width="' + iw + '" height="' + H + '" fill="transparent" id="mk-hit"/>';
      out += "</svg><div class=\"mk-tip\" hidden></div>";
      chartEl.innerHTML = out;
      chartEl.classList.toggle("is-usd", usd);

      if (focusSym) setFocus(focusSym);
      lastRender = { visible: visible, x: x, yOf: yOf, usd: usd, dual: dual, start: start, end: end, m: m, iw: iw, ih: ih, W: W };
      bindHover();
    }

    function bindHover() {
      var svg = chartEl.querySelector("svg");
      var hit = document.getElementById("mk-hit");
      var g = document.getElementById("mk-hover");
      var tip = chartEl.querySelector(".mk-tip");
      var R = lastRender;

      function at(r, day) {
        // last point at or before `day`
        var lo = 0, hi = r.days.length - 1;
        if (day < r.days[0]) return -1;
        while (lo < hi) {
          var mid = (lo + hi + 1) >> 1;
          if (r.days[mid] <= day) lo = mid; else hi = mid - 1;
        }
        return lo;
      }

      function show(clientX) {
        var box = svg.getBoundingClientRect();
        var px = ((clientX - box.left) / box.width) * R.W;
        var day = Math.round(R.start + ((px - R.m.l) / R.iw) * (R.end - R.start));
        day = Math.max(R.start, Math.min(R.end, day));
        var cx = R.x(day);
        var dots = "", rows = [];
        R.visible.forEach(function (v) {
          var i = at(v.r, day);
          if (i < 0) return;
          dots += '<circle class="dot" r="4.5" cx="' + R.x(Math.max(v.r.days[i], R.start)).toFixed(1) + '" cy="' + R.yOf(v, i).toFixed(1) + '" fill="' + v.s.style.color + '"/>';
          rows.push({ v: v, pct: v.r.pct[i], price: v.r.prices[i] });
        });
        rows.sort(R.usd ? function (a, b) { return b.price - a.price; } : function (a, b) { return b.pct - a.pct; });
        g.innerHTML = '<line class="cross" x1="' + cx + '" x2="' + cx + '" y1="' + R.m.t + '" y2="' + (R.m.t + R.ih) + '"/>' + dots;
        g.style.display = "";
        tip.innerHTML = '<div class="mk-tip-date">' + esc(fmtDate(day, { day: "numeric", month: "long", year: "numeric" })) + "</div>" +
          rows.map(function (r) {
            return '<div class="mk-tip-row">' + swatch(r.v.s, 14, 6) + "<b>" + esc(r.v.s.label) + (R.dual ? (r.v.axis ? " →" : " ←") : "") + "</b><span class='mk-tip-price'>" + (R.usd ? fmtUsd(r.v.s, r.price) : fmtPrice(r.price)) + "</span><span class='mk-tip-pct'>" + fmtPct(r.pct) + "</span></div>";
          }).join("");
        tip.hidden = false;
        var frac = cx / R.W;
        var tw = tip.offsetWidth, cw = chartEl.clientWidth;
        var left = frac * cw + (frac > 0.5 ? -tw - 14 : 14);
        tip.style.left = Math.max(4, Math.min(cw - tw - 4, left)) + "px";
      }
      function hide() { g.style.display = "none"; tip.hidden = true; }

      hit.addEventListener("pointermove", function (e) { show(e.clientX); });
      hit.addEventListener("pointerdown", function (e) { show(e.clientX); });
      // A lifted finger keeps the tip up; a tap elsewhere clears it (below).
      hit.addEventListener("pointerleave", function (e) {
        if (e.pointerType !== "touch") hide();
      });
    }

    // ---- $ formatting --------------------------------------------------
    var compact = new Intl.NumberFormat("sk-SK", { notation: "compact", maximumSignificantDigits: 3 });
    function isIndex(s) { return s.symbol.charAt(0) === "^"; }
    function fmtUsd(s, v) { return fmtPrice(v) + (isIndex(s) ? "" : " $"); }
    // Axis ticks: only as many decimals as the step needs ("200", "0,25").
    function axisLabel(v, step) {
      if (Math.abs(v) >= 10000) return compact.format(v);
      var dec = step >= 1 ? 0 : Math.min(4, Math.ceil(-Math.log10(step) - 1e-9));
      return v.toLocaleString("sk-SK", { minimumFractionDigits: dec, maximumFractionDigits: dec });
    }

    // Two-axis split: sort by price (log scale) and cut at the biggest jump,
    // so each axis holds tickers of a similar size.
    function splitAxes(visible) {
      var sorted = visible.map(function (v) {
        return { v: v, lp: Math.log10(Math.max(1e-9, v.r.prices[v.r.prices.length - 1])) };
      }).sort(function (a, b) { return a.lp - b.lp; });
      var cut = 1, gap = -1;
      for (var i = 1; i < sorted.length; i++) {
        if (sorted[i].lp - sorted[i - 1].lp > gap) { gap = sorted[i].lp - sorted[i - 1].lp; cut = i; }
      }
      sorted.forEach(function (o, i) { o.v.axis = i < cut ? 0 : 1; });
    }

    // ---- quote list ------------------------------------------------------
    function sparkline(r, up) {
      var w = 120, h = 38, lo = Infinity, hi = -Infinity;
      r.prices.forEach(function (p) { if (p < lo) lo = p; if (p > hi) hi = p; });
      if (hi === lo) { hi += 1; lo -= 1; }
      var d0 = r.days[0], d1 = r.days[r.days.length - 1];
      var x = function (d) { return ((d - d0) / Math.max(1, d1 - d0)) * w; };
      var y = function (p) { return 2 + (1 - (p - lo) / (hi - lo)) * (h - 4); };
      var path = r.days.map(function (d, i) { return (i ? "L" : "M") + x(d).toFixed(1) + " " + y(r.prices[i]).toFixed(1); }).join("");
      var by = y(r.prices[0]).toFixed(1);
      return '<svg class="mk-spark" viewBox="0 0 ' + w + " " + h + '" preserveAspectRatio="none" aria-hidden="true">' +
        '<line class="base" x1="0" x2="' + w + '" y1="' + by + '" y2="' + by + '" vector-effect="non-scaling-stroke"/>' +
        '<path class="' + (up ? "up" : "down") + '" d="' + path + '" fill="none" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>';
    }

    function drawList(start) {
      listEl.innerHTML = series.map(function (s) {
        var r = slice(s, start);
        var last = r.prices[r.prices.length - 1];
        var pct = r.pct[r.pct.length - 1];
        var on = state.hidden.indexOf(s.symbol) === -1;
        return '<li><button type="button" class="mk-item" data-sym="' + esc(s.symbol) + '" aria-pressed="' + on + '"' +
          ' title="Zobraziť alebo skryť v grafe">' +
          '<span class="mk-sym">' + swatch(s, 18, 8) + "<span><b>" + esc(s.label) + "</b><small>" + esc(s.name) + "</small></span></span>" +
          sparkline(r, pct >= 0) +
          '<span class="mk-quote"><span class="mk-price">' + fmtPrice(last) + '</span><span class="mk-pill ' + (pct >= 0 ? "up" : "down") + '">' + fmtPct(pct) + "</span></span>" +
          "</button></li>";
      }).join("");
    }

    // ---- focus (hover a chip or row to pick out its line) ----------------
    var focusSym = null;

    // Touch: no long-press menu on the chart, and tapping outside it closes
    // the tooltip that stays up after the finger lifts.
    chartEl.addEventListener("contextmenu", function (e) { e.preventDefault(); });
    document.addEventListener("pointerdown", function (e) {
      if (chartEl.contains(e.target)) return;
      var g = document.getElementById("mk-hover"), tip = chartEl.querySelector(".mk-tip");
      if (g) g.style.display = "none";
      if (tip) tip.hidden = true;
    });
    function setFocus(sym) {
      focusSym = sym;
      var any = false;
      chartEl.querySelectorAll(".line").forEach(function (l) {
        var on = l.getAttribute("data-sym") === sym;
        l.classList.toggle("on", on);
        if (on) { any = true; l.parentNode.insertBefore(l, document.getElementById("mk-hover")); }
      });
      chartEl.classList.toggle("has-focus", any);
    }
    function bindFocus(root, selector) {
      ["pointerover", "focusin"].forEach(function (ev) {
        root.addEventListener(ev, function (e) {
          if (e.pointerType === "touch") return;
          var b = e.target.closest(selector);
          if (b) setFocus(b.dataset.sym);
        });
      });
      ["pointerleave", "focusout"].forEach(function (ev) {
        root.addEventListener(ev, function () { setFocus(null); });
      });
    }

    // ---- market weather: strip readouts + sub-forecast tiles ------------
    (function () {
      var names = {{ markets.mood.levels | dump | safe if markets.mood else "[]" }};
      document.querySelectorAll(".mk-w-history").forEach(function (box) {
        var strip = box.querySelector(".mk-w-strip");
        var pick = box.querySelector(".mk-w-pick");
        var rects = strip.querySelectorAll("rect");
        var show = function (clientX) {
          var b = strip.getBoundingClientRect();
          var i = Math.max(0, Math.min(rects.length - 1, Math.floor(((clientX - b.left) / b.width) * rects.length)));
          var r = rects[i], lv = names[+r.dataset.l];
          pick.textContent = r.dataset.d + " · " + lv.icon + " " + lv.name;
        };
        strip.addEventListener("pointermove", function (e) { show(e.clientX); });
        strip.addEventListener("pointerdown", function (e) { show(e.clientX); });
        strip.addEventListener("pointerleave", function (e) { if (e.pointerType !== "touch") pick.textContent = ""; });
        strip.addEventListener("contextmenu", function (e) { e.preventDefault(); });
      });

      // One breakdown open at a time; tapping the open tile closes it.
      var tiles = document.querySelectorAll(".mk-w-tile");
      tiles.forEach(function (t) {
        t.addEventListener("click", function () {
          var open = t.getAttribute("aria-expanded") !== "true";
          tiles.forEach(function (o) {
            var on = open && o === t;
            o.setAttribute("aria-expanded", String(on));
            document.getElementById(o.getAttribute("aria-controls")).hidden = !on;
          });
        });
      });
    })();

    // ---- glue --------------------------------------------------------------
    function update() {
      save();
      document.querySelectorAll(".mk-ranges [data-range]").forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.dataset.range === state.range));
      });
      document.querySelectorAll(".mk-mode [data-mode]").forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.dataset.mode === state.mode));
      });
      document.querySelector(".mk-axes").hidden = state.mode !== "usd";
      document.querySelectorAll(".mk-axes [data-axes]").forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.dataset.axes === state.axes));
      });
      document.querySelectorAll(".mk-chip").forEach(function (b) {
        b.setAttribute("aria-pressed", String(state.hidden.indexOf(b.dataset.sym) === -1));
      });

      var end = Math.max.apply(null, series.map(function (s) { return s.days[s.days.length - 1]; }));
      var start = rangeStart(end);
      drawList(start);

      var visible = series.filter(function (s) { return state.hidden.indexOf(s.symbol) === -1; })
        .map(function (s) { return { s: s, r: slice(s, start) }; });
      if (!visible.length) {
        chartEl.innerHTML = '<p class="mk-empty">Vyber aspoň jeden titul.</p>';
        return;
      }
      // Younger tickers may start later than the range; draw from the earliest data.
      var first = Math.min.apply(null, visible.map(function (v) { return v.r.days[0]; }));
      var from = Math.max(start, first);
      var dfmt = { day: "numeric", month: "numeric", year: "numeric" };
      document.getElementById("mk-span").textContent =
        fmtDate(from, dfmt) + " – " + fmtDate(end, dfmt) +
        (state.mode === "usd" ? " · cena v dolároch" : " · zmena v percentách");
      drawChart(visible, from, end);
    }

    fetch("/trhy/data.json")
      .then(function (r) { return r.json(); })
      .then(function (data) {
        series = data.series.map(function (s) {
          s.style = styleOf(s.slot);
          return s;
        });
        if (!series.length) throw new Error("no data");
        state.hidden = state.hidden.filter(function (sym) {
          return series.some(function (s) { return s.symbol === sym; });
        });
        document.getElementById("mk-note").textContent =
          "Denné záverečné ceny z Yahoo Finance, v USD (VIX je index, nie cena). Naposledy aktualizované " +
          new Date(data.updated).toLocaleDateString("sk-SK", { day: "numeric", month: "long", year: "numeric" }) + ".";
        buildControls();
        listEl.addEventListener("click", function (e) {
          var b = e.target.closest(".mk-item");
          if (!b) return;
          var i = state.hidden.indexOf(b.dataset.sym);
          if (i === -1) state.hidden.push(b.dataset.sym); else state.hidden.splice(i, 1);
          update();
        });
        bindFocus(document.getElementById("mk-chips"), ".mk-chip");
        document.querySelectorAll(".mk-w-show").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var keep = btn.dataset.syms.split(",");
            state.hidden = series.filter(function (s) { return keep.indexOf(s.symbol) === -1; })
              .map(function (s) { return s.symbol; });
            state.range = "30";
            update();
            document.getElementById("mk-span").scrollIntoView({ behavior: "smooth", block: "start" });
          });
        });
        bindFocus(listEl, ".mk-item");
        update();
        var t;
        window.addEventListener("resize", function () {
          clearTimeout(t);
          t = setTimeout(update, 150);
        });
      })
      .catch(function () {
        chartEl.innerHTML = '<p class="mk-empty">Ceny sa nepodarilo načítať. Skús to neskôr.</p>';
      });
  })();
</script>
