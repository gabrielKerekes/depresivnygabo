        "Deň sa začal celkom obyčajne, čo malo byť prvé varovanie.",
        "Babka vždy vravela, že tie dvere sa nemajú otvárať.",
        "Na stole ležala jedna vidlička navyše.",
        "Zabudol som, ako znie ticho, kým sa nevrátila.",
        "Povedali nám, že máme rok. Rozhodli sme sa žiť dva.",
        "V mobile mi pribudla spomienka, ktorú si nepamätám.",
        "Prvý sneh napadol v júli a nečudoval sa nikto, iba ona.",
        "Otvorili sme si účet na spoločné sny a hneď minuli prvý.",
        "Vo vedľajšom byte svietilo svetlo aj po tom, čo sa susedia odsťahovali.",
        "Na konci chodby boli dvere, ktoré tam predtým neboli.",
      ],
    };

    var last = {};
    var buttons = document.querySelectorAll(".game-btn");
    for (var b = 0; b < buttons.length; b++) {
      (function (btn) {
        var key = btn.getAttribute("data-bank");
        var out = btn.parentNode.querySelector(".game-out");
        btn.addEventListener("click", function () {
          var arr = banks[key];
          if (!arr || !arr.length) return;
          var i;
          do {
            i = Math.floor(Math.random() * arr.length);
          } while (arr.length > 1 && i === last[key]);
          last[key] = i;
          out.textContent = arr[i];
          // After the first pick, invite another roll.
          btn.textContent = btn.getAttribute("data-again") || "Skús inú";
        });
      })(buttons[b]);
    }
  })();
</script>
